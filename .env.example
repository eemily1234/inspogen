# 複製成 .env 後填寫（.env 含密碼，絕對不要上傳到 GitHub；已列入 .gitignore）

# ── 網站 ──
# 你的網域，DNS 需先指向這台主機的 IP。例：shop.example.com
DOMAIN=shop.example.com
TZ=Asia/Taipei

# ── 營運後台的 Caddy 密碼保護 ──
ADMIN_USER=admin
# 產生方式：docker run --rm caddy:2 caddy hash-password --plaintext '你的長密碼'
# 把輸出整串貼在下面，並且「一定要用單引號包起來」（雜湊裡有 $ 符號，沒有單引號會被當成變數而壞掉）
# 例：ADMIN_PASSWORD_HASH='$2a$14$abcdefg...'
ADMIN_PASSWORD_HASH=''

# ── 登入安全 ──
# 新建帳號的 PIN 最少位數（對外上線建議 6）
OPS_MIN_PIN_LENGTH=6

# ── 備份 ──
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3

# ── Line 記帳（選用，見 docs/line-setup.md）──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Uber Eats（選用，見 docs/uber-setup.md）──
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# 以下 API 路徑未經驗證，若 Uber 文件不同請在此覆寫：
# UBER_API_BASE=https://api.uber.com
# UBER_TOKEN_URL=https://auth.uber.com/oauth/v2/token
# UBER_ORDER_PATH=/v2/eats/order/{id}
# UBER_ACCEPT_PATH=/v1/eats/orders/{id}/accept_pos_order
# UBER_DENY_PATH=/v1/eats/orders/{id}/deny_pos_order
# UBER_READY_PATH=/v1/eats/orders/{id}/ready
